# Plantilla documental; no contiene credenciales válidas.
# Completar privadamente en .env antes de una futura ejecución autorizada.
# Desde la raíz, Compose debe recibir --env-file .env.
POSTGRES_DB=banuchat
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BANUCHAT_API_HOST=127.0.0.1
BANUCHAT_API_PORT=3000
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# Candidato de generación evaluado en G0; debe coincidir con el runtime local.
BANUCHAT_OLLAMA_BASE_URL=http://127.0.0.1:11434
BANUCHAT_GENERATOR_MODEL=qwen3:4b-instruct
BANUCHAT_GENERATOR_MODEL_REVISION=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
BANUCHAT_GENERATOR_RUNTIME_VERSION=0.35.0
