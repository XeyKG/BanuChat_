{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:ccd:local:v1.1:corpus",
  "title": "BanuChat CCD selected expanded corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_key",
    "version",
    "synthetic",
    "use_scope",
    "validation",
    "sources",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "ccd-1.1.0"
    },
    "dataset_key": {
      "const": "banuchat-ccd-local"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "synthetic": {
      "const": false
    },
    "use_scope": {
      "const": "local_development_only"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "institutional_approval",
        "authorization_ref",
        "note"
      ],
      "properties": {
        "status": {
          "const": "source_checked_local"
        },
        "institutional_approval": {
          "const": false
        },
        "authorization_ref": {
          "const": "BCH-03/incremento-4"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "enum": [
              "DOC-110",
              "BCH01-CIERRE",
              "DOC-098",
              "DOC-099",
              "DOC-100",
              "DOC-101",
              "DOC-102",
              "DOC-103",
              "DOC-104"
            ]
          },
          "path": {
            "$ref": "#/$defs/text"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "c_units",
          "title",
          "retrieval_mode",
          "period",
          "population",
          "applicability_status",
          "editorial_status",
          "content",
          "limits",
          "references"
        ],
        "properties": {
          "id": {
            "enum": [
              "ccd-m01",
              "ccd-m12",
              "ccd-tests-overview",
              "ccd-m02-doc-098",
              "ccd-m02-doc-099",
              "ccd-m02-doc-100",
              "ccd-m02-doc-101",
              "ccd-m02-doc-102",
              "ccd-m02-doc-103",
              "ccd-m02-doc-104"
            ]
          },
          "group": {
            "enum": [
              "M01",
              "M12",
              "M02",
              "TEST_ORIENTATION"
            ]
          },
          "c_units": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "C04",
                "C07",
                "C44",
                "C45",
                "C05",
                "C11"
              ]
            }
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "retrieval_mode": {
            "const": "chunked"
          },
          "period": {
            "enum": [
              "202660",
              "Edición entregada; periodo no confirmado"
            ]
          },
          "population": {
            "$ref": "#/$defs/text"
          },
          "applicability_status": {
            "const": "current_applicability_unconfirmed"
          },
          "editorial_status": {
            "enum": [
              "team_validated_local_candidate",
              "source_checked_local_candidate"
            ]
          },
          "content": {
            "$ref": "#/$defs/text"
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "references": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "enum": [
                    "DOC-110",
                    "BCH01-CIERRE",
                    "DOC-098",
                    "DOC-099",
                    "DOC-100",
                    "DOC-101",
                    "DOC-102",
                    "DOC-103",
                    "DOC-104"
                  ]
                },
                "locator": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "topics": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "group": {
                  "const": "M02"
                }
              }
            },
            "then": {
              "required": [
                "topics"
              ],
              "properties": {
                "topics": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "topics"
                ],
                "properties": {
                  "topics": {}
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "group": {
                  "enum": [
                    "M01",
                    "M12"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "editorial_status": {
                  "const": "team_validated_local_candidate"
                }
              }
            },
            "else": {
              "properties": {
                "editorial_status": {
                  "const": "source_checked_local_candidate"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\r\\n\\u0000]"
      }
    }
  }
}
