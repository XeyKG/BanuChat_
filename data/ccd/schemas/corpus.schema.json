{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:ccd:local:v1:corpus",
  "title": "BanuChat CCD M01/M12 local corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_key", "version", "synthetic", "use_scope", "validation", "sources", "units"],
  "properties": {
    "schema_version": { "const": "ccd-1.0.0" },
    "dataset_key": { "const": "banuchat-ccd-local" },
    "version": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$" },
    "synthetic": { "const": false },
    "use_scope": { "const": "local_development_only" },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "institutional_approval", "authorization_ref", "note"],
      "properties": {
        "status": { "const": "team_validated" },
        "institutional_approval": { "const": false },
        "authorization_ref": { "const": "BCH-03/incremento-1" },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": { "enum": ["DOC-110", "BCH01-CIERRE"] },
          "path": { "$ref": "#/$defs/text" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "units": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "group", "c_units", "title", "retrieval_mode", "period", "population", "applicability_status", "editorial_status", "content", "limits", "references"],
        "properties": {
          "id": { "enum": ["ccd-m01", "ccd-m12"] },
          "group": { "enum": ["M01", "M12"] },
          "c_units": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["C04", "C07", "C44", "C45"] } },
          "title": { "$ref": "#/$defs/text" },
          "retrieval_mode": { "const": "chunked" },
          "period": { "const": "202660" },
          "population": { "$ref": "#/$defs/text" },
          "applicability_status": { "const": "current_applicability_unconfirmed" },
          "editorial_status": { "const": "team_validated_local_candidate" },
          "content": { "$ref": "#/$defs/text" },
          "limits": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/text" } },
          "references": {
            "type": "array", "minItems": 2, "maxItems": 6,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "locator"],
              "properties": {
                "source_id": { "enum": ["DOC-110", "BCH01-CIERRE"] },
                "locator": { "$ref": "#/$defs/text" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S", "not": { "pattern": "[\\r\\n\\u0000]" } } }
}
