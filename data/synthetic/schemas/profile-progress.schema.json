{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:synthetic:v1:profile-progress",
  "title": "BanuChat synthetic v1: profile-progress",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "timezone": {
      "const": "America/Bogota"
    },
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "course_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "enrolled",
              "in_progress",
              "completed"
            ]
          },
          "progress_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 0.01
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "profile_key",
          "course_key",
          "status",
          "progress_percent",
          "started_at",
          "completed_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "enrolled"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "progress_percent": {
                  "const": 0
                },
                "completed_at": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "in_progress"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "progress_percent": {
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 100
                },
                "completed_at": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "progress_percent": {
                  "const": 100
                },
                "completed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "timezone",
    "progress"
  ]
}
