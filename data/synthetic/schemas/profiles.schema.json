{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:synthetic:v1:profiles",
  "title": "BanuChat synthetic v1: profiles",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "profile_key",
          "alias"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "profiles"
  ]
}
