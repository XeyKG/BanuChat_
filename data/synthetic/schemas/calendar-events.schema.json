{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:synthetic:v1:calendar-events",
  "title": "BanuChat synthetic v1: calendar-events",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "const": true
    },
    "timezone": {
      "const": "America/Bogota"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "course_session",
              "announcement_deadline",
              "general"
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "course_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "announcement_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          }
        },
        "required": [
          "event_key",
          "title",
          "description",
          "event_type",
          "starts_at",
          "ends_at",
          "course_key",
          "announcement_key"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "course_session"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "course_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "announcement_key": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "announcement_deadline"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "announcement_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "course_key": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "general"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "course_key": {
                  "type": "null"
                },
                "announcement_key": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "timezone",
    "events"
  ]
}
