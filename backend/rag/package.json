{
  "name": "@banuchat/rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "start": "node dist/main.js",
    "start:local": "node --env-file=../../.env dist/main.js",
    "start:oe2": "node dist/oe2/main.js",
    "start:oe4-calendar": "node dist/oe4/main.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:db": "node --import tsx --test test/db/*.test.ts",
    "test:e2e:ingestion": "node --import tsx --test test/e2e/*.test.ts",
    "validate:dataset": "tsx src/cli.ts",
    "prepare:ccd": "tsx src/ccd/cli.ts",
    "ccd:local": "node --env-file=../../infra/.env.ccd --import tsx src/ccd/load-local.ts",
    "ccd:verify": "node --env-file=../../infra/.env.ccd --import tsx ../../eval/integration/ccd-local-check.mts",
    "evaluate:oe2": "node --import tsx ../../eval/oe2/run-evaluation.mts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
