{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "paths": {"@/*": ["../../mobile/src/*"]},
    "types": ["node"]
  },
  "include": [
    "scripts/*unified*.mts",
    "../../mobile/scripts/evaluate-unified-client.mts",
    "scripts/unified-check.d.ts"
  ]
}
