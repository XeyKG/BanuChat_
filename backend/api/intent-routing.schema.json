                "const": "DocumentLookupService"
              },
              "route_type": {
                "const": "application_service"
              },
              "requires_profile": {
                "const": false
              },
              "default_parameters": {
                "const": {
                  "limit": 10
                }
              },
              "strong_expressions": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/document_lookup_parameters",
                      "required": [
                        "query"
                      ]
                    }
                  }
                }
              },
              "token_combinations": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/document_lookup_parameters",
                      "required": [
                        "query"
                      ]
                    }
                  }
                }
              },
              "lexical_patterns": {
                "items": {
