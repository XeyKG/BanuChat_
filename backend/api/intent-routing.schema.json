                        "this_week",
                        "next_week"
                      ]
                    }
                  }
                }
              },
              "lexical_patterns": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/calendar_events_parameters"
                    },
                    "temporal_rule": {
                      "enum": [
                        "today",
