    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile_selected": {
              "type": "boolean"
            },
            "now": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
