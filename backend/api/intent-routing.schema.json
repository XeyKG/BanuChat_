                  }
                }
              },
              "lexical_patterns": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/course_catalog_parameters"
                    },
                    "temporal_rule": {
                      "const": null
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "calendar_events"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "logical_service": {
                "const": "CalendarEventsService"
              },
              "route_type": {
                "const": "application_service"
              },
              "requires_profile": {
                "const": false
