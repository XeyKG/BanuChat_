                  "properties": {
                    "parameters": {
                      "$ref": "#/$defs/basic_social_parameters"
                    },
                    "temporal_rule": {
                      "const": null
                    },
                    "response_variant": {
                      "enum": [
                        "greeting",
                        "thanks",
                        "farewell"
                      ]
                    }
                  }
                }
              },
              "token_combinations": {
