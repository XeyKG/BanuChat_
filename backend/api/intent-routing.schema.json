{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:intent-routing:1.2.0-draft",
  "title": "BanuChat: catálogo y casos de diseño del Intent Router",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/cases"
    }
  ],
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "enrolled",
              "in_progress",
              "completed",
              "available",
              "closed",
              "archived"
            ]
          }
        },
        "event_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "course_session",
              "announcement_deadline",
              "general"
            ]
          }
        },
        "temporal_status": {
          "type": "string",
          "enum": [
            "active",
            "upcoming",
            "expired",
            "all"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "retrieval_mode": {
          "type": "string",
          "enum": [
            "chunked",
            "full_document"
          ]
        },
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "reference_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": []
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "temporal_rule": {
          "enum": [
            null,
            "today",
            "tomorrow",
            "this_week",
            "next_week"
          ]
        },
        "response_variant": {
          "enum": [
            null,
            "greeting",
            "thanks",
            "farewell",
            "capabilities",
            "not_available"
          ]
        }
      },
      "required": [
        "id",
        "text",
        "parameters",
        "temporal_rule",
        "response_variant"
      ]
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "temporal_rule": {
          "enum": [
            null,
            "today",
            "tomorrow",
            "this_week",
            "next_week"
          ]
        },
        "response_variant": {
          "enum": [
            null,
            "greeting",
            "thanks",
            "farewell",
            "capabilities",
            "not_available"
          ]
        }
      },
      "required": [
        "id",
        "segments",
        "parameters",
        "temporal_rule",
        "response_variant"
      ]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "profile_progress",
            "course_catalog",
            "calendar_events",
            "announcements",
            "document_lookup",
            "capabilities_help",
            "basic_social",
            "known_out_of_scope"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "route_type": {
          "type": "string",
          "enum": [
            "application_service",
            "static_renderer"
          ]
        },
        "logical_service": {
          "enum": [
            null,
            "ProfileProgressService",
            "CourseCatalogService",
            "CalendarEventsService",
            "AnnouncementsService",
            "DocumentLookupService"
          ]
        },
        "requires_profile": {
          "type": "boolean"
        },
        "default_parameters": {
          "$ref": "#/$defs/parameters"
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "strong_expressions": {
          "type": "array",
          "minItems": 15,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "token_combinations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/combination"
          },
          "minItems": 1
        },
        "lexical_patterns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/lexical_pattern"
          }
        },
        "weighted_signal_groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/weighted_signal_group"
          }
        }
      },
      "required": [
        "id",
        "priority",
        "route_type",
        "logical_service",
        "requires_profile",
        "default_parameters",
        "exclusions",
        "strong_expressions",
        "token_combinations",
        "lexical_patterns"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "profile_progress"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "logical_service": {
                "const": "ProfileProgressService"
              },
              "route_type": {
                "const": "application_service"
              },
              "requires_profile": {
                "const": true
              },
              "default_parameters": {
                "const": {
                  "limit": 20
                }
              },
              "strong_expressions": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/profile_progress_parameters"
                    }
                  }
                }
              },
              "token_combinations": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/profile_progress_parameters"
                    }
                  }
                }
              },
              "lexical_patterns": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/profile_progress_parameters"
                    },
                    "temporal_rule": {
                      "const": null
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "course_catalog"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "logical_service": {
                "const": "CourseCatalogService"
              },
              "route_type": {
                "const": "application_service"
              },
              "requires_profile": {
                "const": false
              },
              "default_parameters": {
                "const": {
                  "limit": 20
                }
              },
              "strong_expressions": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/course_catalog_parameters"
                    }
                  }
                }
              },
              "token_combinations": {
                "items": {
                  "properties": {
                    "response_variant": {
                      "const": null
                    },
                    "parameters": {
                      "$ref": "#/$defs/course_catalog_parameters"
