/** Opt-in bounded smoke of the existing API, never a second server or a stress runner. */
import assert from 'node:assert/strict';
import {readFile,writeFile,mkdir,appendFile} from 'node:fs/promises';
import {execFileSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
import {performance} from 'node:perf_hooks';
import {Pool} from 'pg';
import {demoAccounts} from '../test/auth-i1b/accounts.js';
assert.deepEqual(process.argv.slice(2),['--run-once'],'Explicit bounded run required');
const root=new URL('../../../',import.meta.url),directory=new URL('infra/local/oe6-demo-readiness-01/rest-'+Date.now()+'/',root);
execFileSync('git',['check-ignore','--quiet',fileURLToPath(new URL('result.json',directory))],{stdio:'ignore'});await mkdir(directory,{recursive:true});
const cfg=JSON.parse(await readFile(new URL('infra/local/unified/application.json',root),'utf8'));assert.equal(cfg.database,'banuchat_unified');assert.equal(cfg.database_port,55463);assert.equal(cfg.api_port,3004);
const db=new Pool({host:'127.0.0.1',port:55463,database:cfg.database,user:cfg.runtime_user,password:cfg.runtime_password,connectionTimeoutMillis:5000,statement_timeout:10000,options:'-c default_transaction_read_only=on'});
const report:Record<string,any>={at:new Date().toISOString(),result:'RUNNING',requests:[],scope:'Current Unified, sequential HTTP, no retries or deliberate warm-up; not an independent benchmark'};let token='';
const request=async(name:string,path:string,expected:number,method='GET',body?:unknown,binary=false)=>{
 const started=performance.now();try{const r=await fetch('http://127.0.0.1:3004'+path,{method,headers:{...(token?{Authorization:'Bearer '+token}:{}),...(body===undefined?{}:{'Content-Type':'application/json'})},...(body===undefined?{}:{body:JSON.stringify(body)}),signal:AbortSignal.timeout(30000)});
  const data=r.status===204?null:binary?Buffer.from(await r.arrayBuffer()):await r.json();const observation={name,method,status:r.status,expected,duration_ms:Math.round(performance.now()-started)};report.requests.push(observation);await appendFile(new URL('requests-private.jsonl',directory),JSON.stringify(observation)+'\n');assert.equal(r.status,expected,name);return data;
 }catch(error){if(!report.requests.some((r:any)=>r.name===name))report.requests.push({name,method,status:'transport_error',expected,duration_ms:Math.round(performance.now()-started)});throw error;}
};
const fingerprint=async()=>{const names=(await db.query("SELECT n.nspname schema,c.relname name FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind='r' AND n.nspname IN ('banuchat','banuchat_aux') AND c.relname NOT IN ('conversations','messages','message_citations','turn_sources') AND has_table_privilege(c.oid,'SELECT') ORDER BY 1,2")).rows;const result:Record<string,unknown>={};for(const {schema,name}of names){assert.match(schema,/^banuchat(?:_aux)?$/u);assert.match(name,/^[a-z_]+$/u);result[schema+'.'+name]=(await db.query(`SELECT count(*)::int n,md5(coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text)::text,'[]')) hash FROM "${schema}"."${name}" t`)).rows[0];}return result;};
try{
 report.protected_before=await fingerprint();const apiLog=process.env.BANUCHAT_DEMO_API_LOG;const logBefore=apiLog?(await readFile(apiLog,'utf8')).length:null;
 const accounts=await demoAccounts(),login=await request('login','/api/v2/auth/login',200,'POST',{synthetic_uid:accounts[0]!.uid,password:accounts[0]!.password});token=login.access_token;
 const me=await request('current_session','/api/v2/auth/me',200);assert.equal(me.evidence_mode,'ccd_local');assert.equal(me.release_id,'10af4ffd-effb-41fc-bbfe-4dc48cb3398f');
 const progress=await request('progress','/api/v2/me/progress',200),calendar=await request('calendar','/api/v2/calendar/events?date_from=2026-10-01&date_to=2026-11-30',200),news=await request('announcements','/api/v2/announcements?temporal_status=active',200);assert.equal(progress.release_id,calendar.release_id);assert.equal(progress.release_id,news.release_id);assert.notEqual(progress.release_id,me.release_id);
 const programming=await request('oe2_programming','/api/v2/demo/oe2/programming',200),calls=await request('oe2_calls','/api/v2/demo/oe2/announcements?type=calls',200),oe2News=await request('oe2_news','/api/v2/demo/oe2/announcements?type=news',200),changes=await request('banu_al_dia','/api/v2/demo/oe2/changes',200);
 for(const value of [programming,calls,oe2News,changes])assert.equal(value.evidence_mode,'fictional_auxiliary');assert.equal(changes.current_release_id,programming.release_id);assert.equal(changes.comparison_status,'compared');
 const created=await request('create_conversation','/api/v2/conversations',201,'POST',{}),id=created.conversation_id;report.own_conversation_id=id;
 const rag=await request('documentary_turn','/api/v2/conversations/'+id+'/messages',201,'POST',{content:'¿Qué temas se estudian en el curso de Inteligencia Artificial Generativa?'});assert.equal(rag.assistant_message.insufficient_evidence,false);
 const citation=rag.assistant_message.citations.find((c:any)=>c.source_kind==='document'&&c.release_id===me.release_id);assert.ok(citation);assert.ok(citation.artifact_url?.startsWith('/api/v2/documents/'));const artifact=await request('documentary_artifact',citation.artifact_url,200,'GET',undefined,true);assert.ok(artifact.byteLength>0);
 const multi=await request('multisource_turn','/api/v2/conversations/'+id+'/messages',201,'POST',{content:'Según mis cursos completados, ¿qué convocatorias activas podrían interesarme?'});assert.equal(multi.assistant_message.insufficient_evidence,false);assert.ok(multi.assistant_message.citations.some((c:any)=>c.source_kind==='profile_course'));if(news.announcements.length)assert.ok(multi.assistant_message.citations.some((c:any)=>c.source_kind==='announcement'));assert.ok(multi.assistant_message.citations.every((c:any)=>c.release_id===progress.release_id));
 const history=await request('reopen_history','/api/v2/conversations/'+id,200);assert.equal(history.messages.length,4);assert.deepEqual(history.messages[1].citations,rag.assistant_message.citations);assert.deepEqual(history.messages[3].citations,multi.assistant_message.citations);
 report.functional={document_release:me.release_id,auxiliary_release:progress.release_id,oe2_release:programming.release_id,programming:programming.programming.length,calls:calls.announcements.length,news:oe2News.announcements.length,comparison:changes.counts,documentary_citations:rag.assistant_message.citations.length,multisource_citations:multi.assistant_message.citations.length,history_messages:history.messages.length};
 report.private_responses={rag,multi,changes};
 report.correlated_execution={status:'NOT_TESTED',reason:'PRIVATE_API_STDOUT_NOT_SUPPLIED'};
 if(apiLog&&logBefore!==null){const lines=(await readFile(apiLog,'utf8')).slice(logBefore).split(/\r?\n/u).flatMap(line=>{try{return [JSON.parse(line)];}catch{return [];}});const agent=lines.find(r=>r.event==='unified_agent'&&r.terminal_reason==='answered'&&r.selected_tools?.join(',')==='get_profile_progress,get_announcements');const orchestration=lines.find(r=>r.event==='unified_n8n'&&r.operation_id===agent?.operation_id);assert.ok(agent&&orchestration);assert.equal(agent.call_count,2);report.correlated_execution={status:'READY',operation_id:agent.operation_id,tools:agent.selected_tools,call_count:agent.call_count,terminal:agent.terminal_reason,document_release:agent.document_release,structured_release:agent.structured_release};}
 report.protected_after=await fingerprint();assert.deepEqual(report.protected_after,report.protected_before);report.protected_unchanged=true;report.result='PASS';
}catch(error){report.result='FAIL';process.exitCode=1;await writeFile(new URL('failure-private.txt',directory),String(error instanceof Error?error.stack:error));}
finally{if(token){try{await request('logout','/api/v2/auth/logout',204,'POST');await request('revoked_access','/api/v2/auth/me',401);}catch{report.result='FAIL';process.exitCode=1;}}await db.end();await writeFile(new URL('result.json',directory),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({result:report.result,requests:report.requests,correlation:report.correlated_execution,private_directory:fileURLToPath(directory)}));}
