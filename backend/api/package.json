{
  "name": "@banuchat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ops:ccd": "node --import tsx test/auth-i1b-ops-preflight.mts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:auth": "node --import tsx --test test/auth-primitives.test.ts test/auth-handlers.test.ts test/auth-v2-contract.test.ts test/auth-schema.test.ts",
    "test:auth:sql": "node --import tsx test/auth-p1-phase-a.mts",
    "test:auth:roles": "node --import tsx test/auth-p1-roles.mts",
    "test:auth:db": "node --import tsx --test test/auth-p1-db.mts",
    "test:auth:p21:setup": "node --import tsx test/auth-p21-setup.mts",
    "test:auth:p21:sql": "node --import tsx --test test/auth-p21-sql.mts",
    "test:auth:p21:http": "node --import tsx --test test/auth-p21-http.mts",
    "test:auth:p31:setup": "node --import tsx test/auth-p31-setup.mts",
    "test:auth:p31:integration": "node --import tsx --test test/auth-p31-integration.mts",
    "test:auth:p31:evidence": "node --import tsx test/auth-p31-evidence.mts",
    "auth:p32:preflight": "node --import tsx test/auth-p32-preflight.mts",
    "admin:local-account": "node --import tsx src/admin-local-account.ts",
    "start:authenticated": "node --import tsx src/authenticated-main.ts",
    "test:auth:p4l0:setup": "node --import tsx test/auth-p4l0-setup.mts",
    "test:auth:p4l0:integration": "node --import tsx --test test/auth-p4l0-integration.mts",
    "start": "node dist/main.js",
    "start:local": "node --env-file=../../.env dist/main.js",
    "start:ccd": "node --env-file=../../infra/.env.ccd dist/main.js",
    "test:ccd:http": "node --env-file=../../infra/.env.ccd --import tsx ../../eval/integration/ccd-chat-http.mts"
  },
  "dependencies": {
    "argon2": "0.45.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
