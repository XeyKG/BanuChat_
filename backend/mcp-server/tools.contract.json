          "release_id",
          "reference_time",
          "announcements"
        ]
      }
    },
    {
      "name": "get_profile_progress",
      "title": "Consultar progreso del perfil sintético",
      "description": "Consulta el perfil de demostración seleccionado por el contexto controlado del backend y su progreso en la release vigente. El agente no puede elegir el perfil mediante argumentos.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statuses": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "enrolled",
                "in_progress",
                "completed"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        },
        "required": []
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profile_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
              },
              "alias": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_kind": {
                    "type": "string",
                    "const": "profile"
                  },
                  "source_path": {
                    "type": "string",
                    "pattern": "^profiles/[A-Za-z0-9_./-]+$",
                    "not": {
                      "anyOf": [
                        {
                          "pattern": "(^|/)\\.{1,2}(/|$)"
                        },
                        {
                          "pattern": "//|/$|[\\r\\n]"
                        }
                      ]
                    }
                  },
                  "source_locator": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "source_kind",
                  "source_path",
                  "source_locator",
                  "source_sha256"
                ]
              }
            },
            "required": [
              "profile_key",
              "alias",
              "source"
            ]
          },
          "courses": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "course_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "course_name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "enrolled",
                    "in_progress",
                    "completed"
                  ]
                },
                "progress_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "started_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "completed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "const": "profile_course"
                    },
                    "source_path": {
                      "type": "string",
                      "pattern": "^profiles/[A-Za-z0-9_./-]+$",
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "(^|/)\\.{1,2}(/|$)"
                          },
                          {
                            "pattern": "//|/$|[\\r\\n]"
                          }
                        ]
                      }
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "source_kind",
                    "source_path",
                    "source_locator",
                    "source_sha256"
                  ]
                }
              },
              "required": [
                "course_key",
                "course_name",
                "status",
                "progress_percent",
                "started_at",
                "completed_at",
                "source"
              ]
            }
          }
        },
        "required": [
          "release_id",
          "profile",
          "courses"
        ]
      }
    }
  ]
}
