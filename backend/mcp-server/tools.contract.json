{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "2.0.0-draft",
  "mcpProtocolRevision": "2026-07-28",
  "serverName": "banuchat-mcp-server",
  "executionErrorSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "INVALID_ARGUMENT",
          "NOT_FOUND",
          "PROFILE_CONTEXT_REQUIRED",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "retryable": {
        "type": "boolean"
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "code",
      "message",
      "retryable",
      "request_id"
    ]
  },
  "tools": [
    {
      "name": "search_knowledge",
      "title": "Buscar evidencia documental sintética",
      "description": "Recupera chunks de documentos chunked de la release vigente. Genera internamente el embedding; no recibe ni devuelve vectores. found indica coincidencias, no suficiencia para responder.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "format": "uuid"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "found",
                  "not_found"
                ]
              },
              "match_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "status",
              "match_count"
            ]
          },
          "matches": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "chunk_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "document_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "document_version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "document_title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "content_sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "cosine_distance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "page_start": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "page_end": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "const": "document"
                    },
                    "source_path": {
                      "type": "string",
                      "pattern": "^documents/[A-Za-z0-9_./-]+$",
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "(^|/)\\.{1,2}(/|$)"
                          },
                          {
                            "pattern": "//|/$|[\\r\\n]"
                          }
                        ]
                      }
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "source_kind",
                    "source_path",
                    "source_locator",
                    "source_sha256"
                  ]
                }
              },
              "required": [
                "rank",
                "chunk_id",
                "document_key",
                "document_version_id",
                "document_title",
                "content",
                "content_sha256",
                "cosine_distance",
                "locator",
                "page_start",
                "page_end",
                "source"
              ]
            }
          }
        },
        "required": [
          "release_id",
          "evidence",
          "matches"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence": {
                  "properties": {
                    "status": {
                      "const": "not_found"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              },
              "required": [
                "evidence"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "properties": {
                    "match_count": {
                      "const": 0
                    }
                  }
                },
                "matches": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "evidence": {
                  "properties": {
                    "match_count": {
                      "minimum": 1
                    }
                  }
                },
                "matches": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "find_documents",
      "title": "Localizar documentos sintéticos",
      "description": "Busca por identidad y título en documentos de la release vigente, incluidas guías full_document. Devuelve metadatos y procedencia, no archivos ni enlaces.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "retrieval_mode": {
            "type": "string",
            "enum": [
              "chunked",
              "full_document"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "format": "uuid"
          },
          "documents": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "document_version_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "retrieval_mode": {
                  "type": "string",
                  "enum": [
                    "chunked",
                    "full_document"
                  ]
                },
                "mime_type": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "version_label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "const": "document"
                    },
                    "source_path": {
                      "type": "string",
                      "pattern": "^documents/[A-Za-z0-9_./-]+$",
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "(^|/)\\.{1,2}(/|$)"
                          },
                          {
                            "pattern": "//|/$|[\\r\\n]"
                          }
                        ]
                      }
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "source_kind",
                    "source_path",
                    "source_locator",
                    "source_sha256"
                  ]
                }
              },
              "required": [
                "document_key",
                "document_version_id",
                "title",
                "retrieval_mode",
                "mime_type",
                "version_label",
                "source"
              ]
            }
          }
        },
        "required": [
          "release_id",
          "documents"
        ]
      }
    },
    {
