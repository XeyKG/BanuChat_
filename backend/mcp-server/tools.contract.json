                          {
                            "pattern": "//|/$|[\\r\\n]"
                          }
                        ]
                      }
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "source_kind",
                    "source_path",
                    "source_locator",
                    "source_sha256"
                  ]
                }
              },
              "required": [
                "announcement_key",
                "title",
                "description",
                "valid_from",
                "valid_until",
