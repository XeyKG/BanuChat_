    {
      "name": "get_calendar_events",
      "title": "Consultar eventos sintéticos",
      "description": "Corrección preimplementación del draft 2.0.0-draft: date_from y date_to delimitan días civiles inclusivos en America/Bogota, zona canónica técnica del MVP, no afirmación institucional. Máximo 366 días, date_to >= date_from. Transformar 00:00 de date_from y 00:00 del día posterior a date_to en esa zona a instantes con zona; filtrar starts_at con inicio incluido y fin excluido, sin solapamiento. Solo release vigente. Timestamps de salida RFC 3339 con zona/offset.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date_from": {
            "type": "string",
            "format": "date"
          },
          "date_to": {
            "type": "string",
            "format": "date"
          },
          "event_types": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "course_session",
                "announcement_deadline",
                "general"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        },
        "required": [
          "date_from",
          "date_to"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "release_id": {
            "type": "string",
            "format": "uuid"
          },
          "events": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "event_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "event_type": {
                  "type": "string",
                  "enum": [
                    "course_session",
                    "announcement_deadline",
                    "general"
                  ]
                },
                "starts_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "ends_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "course_key": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "announcement_key": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "const": "calendar_event"
                    },
                    "source_path": {
                      "type": "string",
                      "pattern": "^calendars/[A-Za-z0-9_./-]+$",
                      "not": {
                        "anyOf": [
                          {
                            "pattern": "(^|/)\\.{1,2}(/|$)"
                          },
                          {
                            "pattern": "//|/$|[\\r\\n]"
                          }
                        ]
                      }
                    },
                    "source_locator": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64,
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "source_kind",
                    "source_path",
                    "source_locator",
                    "source_sha256"
                  ]
                }
              },
              "required": [
                "event_key",
                "title",
                "description",
                "event_type",
                "starts_at",
                "ends_at",
                "course_key",
                "announcement_key",
                "source"
              ]
            }
          }
        },
        "required": [
          "release_id",
          "events"
        ]
      }
    },
