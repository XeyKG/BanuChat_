{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:eval:rag-quality:reserve:v1",
  "title": "BanuChat M9 hidden reserve",
  "description": "Schema for the reserve file kept outside the tuning repository; it contains no observed results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reserve_id", "benchmark_id", "status", "corpus", "top_k", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reserve_id": {"type": "string", "pattern": "^banuchat-rag-quality-m9-reserve-v[1-9][0-9]*$"},
    "benchmark_id": {"type": "string", "pattern": "^banuchat-rag-quality-m9-v[1-9][0-9]*$"},
    "status": {"enum": ["draft", "frozen"]},
    "corpus": {"$ref": "#/$defs/corpus"},
    "top_k": {"const": 5},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]},
    "then": {"properties": {"cases": {
      "minItems": 20,
      "maxItems": 30,
      "items": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"review_status": {"const": "approved"}}}]}
    }}}
  }],
  "$defs": {
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_key", "source_manifest", "documents_index", "eligible_retrieval_mode", "eligible_document_keys", "excluded_document_keys", "eligible_document_count", "documented_chunk_count"],
      "properties": {
        "dataset_key": {"const": "banuchat-synthetic"},
        "source_manifest": {"const": "data/synthetic/manifest.json"},
        "documents_index": {"const": "data/synthetic/documents/documents.json"},
        "eligible_retrieval_mode": {"const": "chunked"},
        "eligible_document_keys": {"const": ["doc-001", "doc-002", "doc-003", "doc-004", "doc-005", "doc-006", "doc-007", "doc-008", "doc-009", "doc-010"]},
        "excluded_document_keys": {"const": ["doc-011", "doc-012"]},
        "eligible_document_count": {"const": 10}, "documented_chunk_count": {"const": 60}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "question_type", "reference_answer", "relevant_contexts", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^M9-R-[0-9]{3}$"},
        "question": {"type": "string", "minLength": 1},
        "question_type": {"enum": ["single_context", "multi_context_same_document", "multi_context_cross_document"]},
        "reference_answer": {"type": "string", "minLength": 1},
        "relevant_contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relevant_context"}},
        "review_status": {"enum": ["draft", "reviewed", "approved", "rejected"]},
        "review_notes": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"question_type": {"const": "single_context"}}, "required": ["question_type"]}, "then": {"properties": {"relevant_contexts": {"maxItems": 1}}}},
        {"if": {"properties": {"question_type": {"enum": ["multi_context_same_document", "multi_context_cross_document"]}}, "required": ["question_type"]}, "then": {"properties": {"relevant_contexts": {"minItems": 2}}}}
      ]
    },
    "relevant_context": {
      "type": "object", "additionalProperties": false,
      "required": ["document_key", "ordinal", "locator", "source_sha256"],
      "properties": {
        "document_key": {"enum": ["doc-001", "doc-002", "doc-003", "doc-004", "doc-005", "doc-006", "doc-007", "doc-008", "doc-009", "doc-010"]},
        "ordinal": {"type": "integer", "minimum": 0}, "locator": {"type": "string", "minLength": 1}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
