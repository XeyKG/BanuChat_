{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:eval:rag-quality:benchmark:v1",
  "title": "BanuChat M9 RAG quality benchmark",
  "description": "Gold versionado para la evaluación formal de calidad RAG de OE1; no contiene resultados observados.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "corpus",
    "top_k",
    "splits",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^banuchat-rag-quality-m9-v[1-9][0-9]*$"
    },
    "status": {
      "enum": ["draft", "frozen"]
    },
    "corpus": {
      "$ref": "#/$defs/corpus"
    },
    "top_k": {
      "const": 5
    },
    "splits": {
      "$ref": "#/$defs/splits"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "splits": {
            "properties": {
              "primary": {
                "properties": {
                  "actual_case_count": {
                    "const": 60
                  }
                }
              },
              "reserve": {
                "properties": {
                  "actual_case_count": {
                    "minimum": 20,
                    "maximum": 30
                  }
                }
              }
            }
          },
          "cases": {
            "minItems": 80,
            "maxItems": 90,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/case"
                },
                {
                  "properties": {
                    "review_status": {
                      "const": "approved"
                    }
                  }
                }
              ]
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "split": {
                      "const": "primary"
                    }
                  },
                  "required": ["split"]
                },
                "minContains": 60,
                "maxContains": 60
              },
              {
                "contains": {
                  "properties": {
                    "split": {
                      "const": "reserve"
                    }
                  },
                  "required": ["split"]
                },
                "minContains": 20,
                "maxContains": 30
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_key",
        "source_manifest",
        "documents_index",
        "eligible_retrieval_mode",
        "eligible_document_keys",
        "excluded_document_keys",
        "eligible_document_count",
        "documented_chunk_count"
      ],
      "properties": {
        "dataset_key": {
          "const": "banuchat-synthetic"
        },
        "source_manifest": {
          "const": "data/synthetic/manifest.json"
        },
        "documents_index": {
          "const": "data/synthetic/documents/documents.json"
        },
        "eligible_retrieval_mode": {
          "const": "chunked"
        },
        "eligible_document_keys": {
          "const": [
            "doc-001",
            "doc-002",
            "doc-003",
            "doc-004",
            "doc-005",
            "doc-006",
            "doc-007",
            "doc-008",
            "doc-009",
            "doc-010"
          ]
        },
        "excluded_document_keys": {
          "const": ["doc-011", "doc-012"]
        },
        "eligible_document_count": {
          "const": 10
        },
        "documented_chunk_count": {
          "const": 60
        }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "reserve"],
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_case_count", "actual_case_count"],
          "properties": {
            "target_case_count": {
              "const": 60
            },
            "actual_case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            }
          }
        },
        "reserve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_min_case_count", "target_max_case_count", "actual_case_count"],
          "properties": {
            "target_min_case_count": {
              "const": 20
            },
            "target_max_case_count": {
              "const": 30
            },
            "actual_case_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "split",
        "question",
        "question_type",
        "reference_answer",
        "relevant_contexts",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M9-(?:P|R)-[0-9]{3}$"
        },
        "split": {
          "enum": ["primary", "reserve"]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "question_type": {
          "enum": [
            "single_context",
            "multi_context_same_document",
            "multi_context_cross_document"
          ]
        },
        "reference_answer": {
          "type": "string",
          "minLength": 1
        },
        "relevant_contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relevant_context"
          }
        },
        "review_status": {
          "enum": ["draft", "reviewed", "approved", "rejected"]
        },
        "review_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "split": {
                "const": "primary"
              }
            },
            "required": ["split"]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^M9-P-[0-9]{3}$"
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "pattern": "^M9-R-[0-9]{3}$"
              }
            }
          }
        }
      ]
    },
    "relevant_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_key", "ordinal", "locator"],
      "properties": {
        "document_key": {
          "enum": [
            "doc-001",
            "doc-002",
            "doc-003",
            "doc-004",
            "doc-005",
            "doc-006",
            "doc-007",
            "doc-008",
            "doc-009",
            "doc-010"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

