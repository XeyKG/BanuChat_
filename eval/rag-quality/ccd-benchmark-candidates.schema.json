{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:eval:oe1:ccd-candidates:v1",
  "title": "BanuChat OE1 CCD candidate benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "status", "visibility", "corpus", "top_k", "partition_proposal", "cases", "non_answerable_cases"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "benchmark_id": {"const": "banuchat-oe1-ccd-candidates-v1"},
    "status": {"const": "draft"},
    "visibility": {"const": "private_local_ignored"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "dataset_key", "release_id", "release_status", "schema_version", "manifest_sha256", "document_count", "chunk_count"],
      "properties": {
        "environment": {"const": "banuchat-dev"},
        "dataset_key": {"const": "banuchat-ccd-local"},
        "release_id": {"type": "string", "format": "uuid"},
        "release_status": {"const": "ready"},
        "schema_version": {"const": "ccd-1.2.0"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "document_count": {"const": 12},
        "chunk_count": {"const": 12}
      }
    },
    "top_k": {"const": 5},
    "partition_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "reserve_candidate", "reserve_is_hidden"],
      "properties": {
        "development": {"const": 35},
        "reserve_candidate": {"const": 15},
        "reserve_is_hidden": {"const": false},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "cases": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/case"}},
    "non_answerable_cases": {"type": "array", "items": {"$ref": "#/$defs/non_answerable"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_key", "ordinal", "locator", "source_sha256"],
      "properties": {
        "document_key": {"type": "string", "pattern": "^ccd-[a-z0-9-]+$"},
        "ordinal": {"const": 0},
        "locator": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proposed_split", "question", "query_type", "question_type", "reference_answer", "relevant_contexts", "evidence_class", "evidence_sufficient", "review_status", "restrictions", "review_notes"],
      "properties": {
        "id": {"type": "string", "pattern": "^OE1-CCD-C-[0-9]{3}$"},
        "proposed_split": {"enum": ["development", "reserve_candidate"]},
        "question": {"type": "string", "minLength": 1},
        "query_type": {"enum": ["factual", "documentary_orientation", "boundary", "comparison"]},
        "question_type": {"enum": ["single_context", "multi_context_cross_document"]},
        "reference_answer": {"type": "string", "minLength": 1},
        "relevant_contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/context"}},
        "evidence_class": {"enum": ["documented", "documented_with_temporal_limit", "permitted_interpretation"]},
        "evidence_sufficient": {"const": true},
        "review_status": {"const": "draft"},
        "restrictions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review_notes": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"question_type": {"const": "single_context"}}, "required": ["question_type"]}, "then": {"properties": {"relevant_contexts": {"maxItems": 1}}}},
        {"if": {"properties": {"question_type": {"const": "multi_context_cross_document"}}, "required": ["question_type"]}, "then": {"properties": {"relevant_contexts": {"minItems": 2}}}}
      ]
    },
    "non_answerable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "expected_behavior", "reason", "excluded_from_answerable_metrics", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^OE1-CCD-N-[0-9]{3}$"},
        "question": {"type": "string", "minLength": 1},
        "expected_behavior": {"enum": ["abstain", "clarify", "partial_with_limit"]},
        "reason": {"type": "string", "minLength": 1},
        "excluded_from_answerable_metrics": {"const": true},
        "review_status": {"const": "draft"}
      }
    }
  }
}
