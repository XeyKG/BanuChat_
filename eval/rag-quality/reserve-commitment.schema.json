{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banuchat:eval:rag-quality:reserve-commitment:v1",
  "title": "BanuChat M9 reserve commitment",
  "description": "Non-revealing commitment metadata; reserve questions and gold stay outside the tuning repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commitment_id", "benchmark_id", "expected_case_count", "hash_algorithm", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "commitment_id": {"type": "string", "pattern": "^banuchat-rag-quality-m9-reserve-v[1-9][0-9]*$"},
    "benchmark_id": {"type": "string", "pattern": "^banuchat-rag-quality-m9-v[1-9][0-9]*$"},
    "expected_case_count": {"type": "integer", "minimum": 20, "maximum": 30},
    "hash_algorithm": {"const": "sha256"},
    "status": {"enum": ["draft", "committed"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "committed"}}, "required": ["status"]}, "then": {"required": ["content_sha256"]}},
    {"if": {"properties": {"status": {"const": "draft"}}, "required": ["status"]}, "then": {"not": {"required": ["content_sha256"]}}}
  ]
}
