# Copiar a infra/local/oe6/oe6.env. Nunca versionar valores reales.
BANUCHAT_IMAGE_TAG=oe6-local
POSTGRES_DB=banuchat_schema_test
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SYNTHETIC_POSTGRES_VOLUME=banuchat-schema-test_pgvector_data

MCP_POSTGRES_USER=banuchat_mcp_reader
MCP_POSTGRES_PASSWORD=

N8N_PORT=5678
N8N_ENCRYPTION_KEY=
N8N_VOLUME=banuchat-schema-test_n8n_data
BANUCHAT_N8N_SERVICE_TOKEN=
BANUCHAT_N8N_CONVERSATION_TIMEOUT_MS=4000

BANUCHAT_GENERATOR_MODEL_REVISION=qwen3:4b-instruct
BANUCHAT_GENERATOR_RUNTIME_VERSION=ollama-0.35.0
OLLAMA_VOLUME=banuchat-oe6-ollama-data

# Solo para el perfil operations. La URL no debe apuntar a CCD.
BANUCHAT_INGESTION_DATABASE_URL=
BANUCHAT_INGESTION_SERVICE_TOKEN=
BANUCHAT_OE4_SERVICE_TOKEN=

# Perfil opcional ccd-auth. Mantiene base, volumen y artefactos separados.
CCD_AUTH_POSTGRES_DB=banuchat_ccd_auth_i1b_test
CCD_AUTH_POSTGRES_USER=
CCD_AUTH_POSTGRES_PASSWORD=
CCD_AUTH_POSTGRES_PORT=55453
CCD_AUTH_POSTGRES_VOLUME=banuchat-dev-ccd-auth-data
CCD_AUTH_DEPLOYMENT=
CCD_AUTH_RATE_KEY=
CCD_AUTH_RUNTIME_USER=
CCD_AUTH_RUNTIME_PASSWORD=
CCD_AUTH_API_PORT=3003
CCD_LOCAL_DATA_ROOT=../data/ccd/local
