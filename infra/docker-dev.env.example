# Plantilla de validación para infra/docker-compose.dev.yml.
# Copiar a infra/local/docker-dev.env y reemplazar todos los marcadores privados.
# El archivo real queda fuera de Git por estar bajo infra/local/.

# Se conserva el nombre físico del laboratorio CCD autenticado vigente.
CCD_AUTH_POSTGRES_DB=banuchat_ccd_auth_i1b_test
CCD_AUTH_POSTGRES_USER=
CCD_AUTH_POSTGRES_PASSWORD=
CCD_AUTH_POSTGRES_PORT=55443
CCD_AUTH_POSTGRES_VOLUME=banuchat-dev-ccd-auth-data
CCD_AUTH_NETWORK=banuchat-dev-ccd-auth

# La demo histórica permanece separada del corpus CCD.
SYNTHETIC_POSTGRES_DB=banuchat_schema_test
SYNTHETIC_POSTGRES_USER=
SYNTHETIC_POSTGRES_PASSWORD=
SYNTHETIC_POSTGRES_PORT=5432
SYNTHETIC_POSTGRES_VOLUME=banuchat-dev-synthetic-data
SYNTHETIC_NETWORK=banuchat-dev-synthetic

# N8N solo orquesta ingesta asíncrona; no pertenece al chat síncrono.
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
N8N_VOLUME=banuchat-dev-n8n-data
N8N_NETWORK=banuchat-dev-automation
