[Unit]
Description=BanuChat private n8n orchestration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=banuchat-n8n
Group=banuchat-n8n
WorkingDirectory=/var/lib/banuchat-n8n
Environment=HOME=/var/lib/banuchat-n8n
Environment=NODE_ENV=production
Environment=N8N_USER_FOLDER=/var/lib/banuchat-n8n
Environment=N8N_LISTEN_ADDRESS=127.0.0.1
Environment=N8N_PORT=15679
Environment=N8N_HOST=n8n.banuchat.duckdns.org
Environment=N8N_PROTOCOL=http
Environment=N8N_EDITOR_BASE_URL=https://n8n.banuchat.duckdns.org
Environment=WEBHOOK_URL=http://127.0.0.1:15679/
Environment=N8N_PROXY_HOPS=1
Environment=N8N_SECURE_COOKIE=true
Environment=N8N_DIAGNOSTICS_ENABLED=false
Environment=N8N_PERSONALIZATION_ENABLED=false
Environment=N8N_VERSION_NOTIFICATIONS_ENABLED=false
Environment=N8N_COMMUNITY_PACKAGES_ENABLED=false
Environment=N8N_PUBLIC_API_DISABLED=true
Environment=EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
Environment=EXECUTIONS_DATA_SAVE_ON_ERROR=none
Environment=EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
Environment=GENERIC_TIMEZONE=America/Bogota
Environment=TZ=America/Bogota
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/local/bin/node /opt/banuchat/operations/n8n/node_modules/n8n/bin/n8n start
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/banuchat-n8n
MemoryHigh=650M
MemoryMax=900M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=multi-user.target
